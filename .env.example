# Cloudflare API token for wrangler (see README "Cloudflare access")
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 32 random bytes as hex: encrypts stored provider keys in D1 (just secrets-key)
SECRETS_KEY=

# Deployed-site e2e tests (just e2e); the accounts exist only for this
E2E_APP_URL=https://app.alexsay.com
E2E_SITE_URL=https://www.alexsay.com
E2E_ADMIN_USERNAME=test-admin
E2E_ADMIN_PASSWORD=
E2E_USER_USERNAME=test-user
E2E_USER_PASSWORD=
# just e2e-llm: a real OpenAI key (a project with a small budget), used only by those tests
E2E_OPENAI_API_KEY=
# Turnstile: the widget's site key goes in api/wrangler.jsonc, the secret to the Worker; the bypass is a random
# string the e2e suite sends as x-turnstile-bypass (also a Worker secret and a GitHub secret)
TURNSTILE_KEY=
TURNSTILE_SECRET=
TURNSTILE_BYPASS=

# Ed25519 seed (64 hex) that signs release checksum lists; also the ALEXSAY_RELEASE_KEY GitHub secret
ALEXSAY_RELEASE_KEY=
