{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexsay-app",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-15",
  "routes": [{ "pattern": "app.alexsay.com", "custom_domain": true }],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alexsay",
      "database_id": "7cc3c19a-8f07-45f2-9666-bd17894a0f0b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["23 3 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "CALL_AGENT", "class_name": "CallAgent" },
      { "name": "LINE_BRIDGE", "class_name": "LineBridge" },
      { "name": "SCHEDULER", "class_name": "Scheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["LineBridge"] },
    { "tag": "v3", "new_sqlite_classes": ["Scheduler"] }
  ],
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "LIGHTWAVE_AUTH_URL": "https://auth.lightwaverf.com/token",
    "LIGHTWAVE_BASE_URL": "https://publicapi.lightwaverf.com/v1",
    "TWILIO_BASE_URL": "https://api.twilio.com"
  },
  "observability": { "enabled": true }
}
